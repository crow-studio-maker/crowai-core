# Development only. Production must provide a strong secret through its secret manager.
CROWAI_ENV=development
CROWAI_SECRET_KEY=
CROWAI_INSTANCE_DIR=instance
CROWAI_UPLOAD_DIR=uploads
CROWAI_MODELS_DIR=models
CROWAI_USERS_DIR=users
CROWAI_MAX_MESSAGE_LENGTH=12000
CROWAI_MAX_UPLOAD_BYTES=33554432
CROWAI_MAX_UPLOAD_FILES=10
CROWAI_MAX_REQUEST_BYTES=134217728
CROWAI_SESSION_DAYS=7
CROWAI_LOG_LEVEL=INFO
CROWAI_ENABLE_WEB_SEARCH=true
CROWAI_STRICT_MODEL_CAPABILITIES=false
CROWAI_MODEL_DEVELOPMENT_RELOAD=true
CROWAI_HOST=127.0.0.1
CROWAI_PORT=5000
